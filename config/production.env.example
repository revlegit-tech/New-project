MLB_APP_ENV=production
PYTHONPATH=/app
DB_ENABLED=1
DB_FALLBACK_TO_CSV=1
DATABASE_URL=postgresql://mlb_app:replace-with-secure-password@postgres:5432/mlb_app
GAME_MARKET_ENRICHMENT_ENABLED=1
TEAM_GAME_MARKET_PROJECTIONS_ENABLED=0
MLB_RESEARCH_MODE_DEFAULT=1
MLB_CURRENT_SEASON=2026
MLB_CSP_REPORT_ONLY=0
MLB_CSP_ALLOW_INLINE=0
MLB_TRUSTED_PROXY_CIDRS=127.0.0.1/32
