  align-items: center;
  padding: 9px 12px;
  border-bottom: 1px solid rgba(244, 247, 246, 0.08);
  font-size: 0.73rem;
  font-weight: 850;
}

.prop-detail-table-head {
  color: var(--ob-muted, #9ca5a1);
  background: rgba(255, 255, 255, 0.035);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.prop-detail-table-row:last-child { border-bottom: 0; }
.prop-detail-table-row strong { color: var(--ob-text, #f4f7f6); }
.prop-detail-table-row em { color: var(--ob-red, #ff5e6c); font-style: normal; }
.prop-detail-table-row.is-hit em { color: var(--ob-green, #18d99c); }

.prop-detail-price-table.advanced {
  display: grid;
  gap: 8px;
}

.prop-detail-price-table.advanced > div {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto auto;
  gap: 12px;
  align-items: center;
  border: 1px solid rgba(244, 247, 246, 0.1);
  border-radius: 12px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.025);
}

.prop-detail-price-table.advanced > div.is-best {
  border-color: rgba(24, 217, 156, 0.34);
  background: rgba(24, 217, 156, 0.075);
}

.prop-detail-price-table.advanced span,
.prop-detail-price-table.advanced em {
  color: var(--ob-muted, #9ca5a1);
  font-size: 0.72rem;
  font-style: normal;
  font-weight: 850;
}

.prop-detail-price-table.advanced strong {
  color: var(--ob-text, #f4f7f6);
  font-size: 0.88rem;
  font-weight: 950;
}

.prop-detail-price-table.advanced b {
  border-radius: 999px;
  padding: 3px 8px;
  color: #06100d;
  background: var(--ob-green, #18d99c);
  font-size: 0.65rem;
  font-weight: 950;
}

.prop-detail-context-grid,
.prop-detail-warning-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.prop-detail-warning-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.prop-detail-context-grid h4,
.prop-detail-warning-grid h4 {
  margin: 0 0 8px;
  color: var(--ob-text, #f4f7f6);
  font-size: 0.82rem;
}

.outlier-mode .ob-rail-hit-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-top: 10px;
}

.outlier-mode .ob-rail-hit-strip span {
  border: 1px solid var(--ob-line);
  border-radius: 10px;
  padding: 7px 8px;
  background: rgba(255, 255, 255, 0.025);
}

.outlier-mode .ob-rail-hit-strip b,
.outlier-mode .ob-rail-hit-strip em {
  display: block;
  font-style: normal;
}

.outlier-mode .ob-rail-hit-strip b {
  color: var(--ob-muted);
  font-size: 0.62rem;
  font-weight: 950;
}

.outlier-mode .ob-rail-hit-strip em {
  color: var(--ob-green);
  font-size: 0.82rem;
  font-weight: 950;
}

.outlier-mode .ob-rail-game-graph {
  height: 118px;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(11px, 1fr);
  align-items: end;
  gap: 4px;
  margin-top: 12px;
  padding-top: 6px;
}

.outlier-mode .ob-rail-game-graph span {
  height: 100%;
  display: flex;
  align-items: end;
  justify-content: center;
  position: relative;
}

.outlier-mode .ob-rail-game-graph i {
  width: 100%;
  border-radius: 5px 5px 0 0;
  background: rgba(255, 94, 108, 0.58);
}

.outlier-mode .ob-rail-game-graph .is-hit i {
  background: var(--ob-green);
}

.outlier-mode .ob-rail-game-graph b {
  position: absolute;
  bottom: -15px;
  color: var(--ob-muted);
  font-size: 0.55rem;
}

.outlier-mode .ob-rail-book-list {
  display: grid;
  gap: 7px;
  padding: 12px;
}

.outlier-mode .ob-rail-book-list div {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 8px;
  align-items: center;
  border: 1px solid var(--ob-line-soft);
  border-radius: 9px;
  padding: 8px;
  font-size: 0.72rem;
}

.outlier-mode .ob-rail-book-list div.is-best {
  border-color: rgba(24, 217, 156, 0.35);
  background: rgba(24, 217, 156, 0.08);
}

.outlier-mode .ob-rail-book-list span,
.outlier-mode .ob-rail-book-list em {
  color: var(--ob-muted);
  font-style: normal;
  font-weight: 800;
}

.outlier-mode .ob-rail-book-list strong {
  color: var(--ob-text);
  font-weight: 950;
}

@media (max-width: 980px) {
  .prop-detail-premium-hero,
  .prop-detail-hero-kpis,
  .prop-detail-hit-grid,
  .prop-detail-context-grid,
  .prop-detail-warning-grid {
    grid-template-columns: 1fr;
  }

  .prop-detail-price-table.advanced > div {
    grid-template-columns: 1fr auto;
  }
}


