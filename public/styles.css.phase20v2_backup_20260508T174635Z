}

.muse-statcast-read ul {
  margin: 0;
  padding-left: 1.25rem;
  color: #334155;
  line-height: 1.55;
}

/* Muse Overview landing tab */
.muse-overview-layout {
  display: grid;
  gap: 0.9rem;
}

.muse-overview-hero-card,
.muse-overview-card {
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  background: #fff;
  padding: 1rem;
}

.muse-overview-hero-card {
  display: flex;
  justify-content: space-between;
