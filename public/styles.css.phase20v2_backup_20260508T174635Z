  background: var(--accent);
  box-shadow: 0 12px 22px rgba(15, 118, 110, 0.18);
}

#simpleSave,
#allDataSavePredictionButton,
#dailyAfterButton,
#predictionSaveButton,
#predictionGradeButton,
#unifiedBackfillButton,
#modelRefreshButton {
  border: 1px solid rgba(15, 118, 110, 0.42);
  color: var(--accent-dark);
  background: #fff;
  box-shadow: none;
}

#dailyStatusButton,
#unifiedStatusButton,
#predictionDashboardLoadButton,
#dataHealthButton,
#savantStatusButton,
#weatherStatusButton,
#oddsMovementStatusButton,
