/* ======================================================
   Clean Workflow UI v2
   ====================================================== */

.clean-ui-v2 {
  --clean-bg: #f6f7fb;
  --clean-panel: #ffffff;
  --clean-panel-soft: #fafbff;
  --clean-border: #d9e0ea;
  --clean-border-soft: #e8edf4;
  --clean-text: #152033;
  --clean-muted: #64748b;
  --clean-accent: #2563eb;
  --clean-accent-soft: #eff6ff;
  --clean-shadow: 0 8px 28px rgba(15, 23, 42, 0.08);
  background: var(--clean-bg);
  color: var(--clean-text);
}

/* Give the app breathing room */
.clean-ui-v2 main,
.clean-ui-v2 .container,
.clean-ui-v2 .app-main,
.clean-ui-v2 .main-content {
  max-width: 1500px;
  margin-left: auto;
  margin-right: auto;
}

/* Top jump nav */
.workflow-jump-nav {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  padding: 0.75rem;
  margin: 0 0 1rem;
  border: 1px solid var(--clean-border-soft);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
}

.workflow-jump-nav a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.25rem;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  color: var(--clean-text);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 700;
  background: var(--clean-panel-soft);
  border: 1px solid var(--clean-border-soft);
}

.workflow-jump-nav a:hover {
  color: var(--clean-accent);
  border-color: var(--clean-accent);
  background: var(--clean-accent-soft);
}

/* Workflow sections */
.workflow-section {
  margin: 1.25rem 0;
  padding: 1rem;
  border: 1px solid var(--clean-border);
  border-radius: 24px;
  background: var(--clean-panel);
  box-shadow: var(--clean-shadow);
}

.workflow-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.25rem 0.25rem 0.9rem;
  border-bottom: 1px solid var(--clean-border-soft);
  margin-bottom: 1rem;
}

.workflow-section-header h2 {
  margin: 0;
  font-size: clamp(1.1rem, 1.5vw, 1.45rem);
  letter-spacing: -0.02em;
}

.workflow-section-header p {
  margin: 0.35rem 0 0;
  color: var(--clean-muted);
  font-size: 0.94rem;
  line-height: 1.45;
}

.workflow-section-body {
  display: grid;
  gap: 1rem;
}

/* Panel cards */
.clean-ui-v2 details.model-refresh-panel,
.clean-ui-v2 .workflow-section details {
  border: 1px solid var(--clean-border-soft);
  border-radius: 18px;
  background: var(--clean-panel-soft);
  overflow: hidden;
  box-shadow: none;
}

.clean-ui-v2 details.model-refresh-panel[open],
.clean-ui-v2 .workflow-section details[open] {
  background: var(--clean-panel);
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
}

.clean-ui-v2 details.primary-panel {
  border-color: rgba(37, 99, 235, 0.35);
}

.clean-ui-v2 details.advanced-panel {
  opacity: 0.92;
}

.clean-ui-v2 summary {
  min-height: 3rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.85rem 1rem;
  cursor: pointer;
  font-weight: 800;
  list-style: none;
  overflow: hidden;
}

.clean-ui-v2 summary::-webkit-details-marker {
  display: none;
}

.clean-ui-v2 summary::after {
  content: "?";
  flex: 0 0 auto;
  color: var(--clean-muted);
  transition: transform 0.18s ease;
}

.clean-ui-v2 details[open] > summary::after {
  transform: rotate(180deg);
}

.workflow-summary-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workflow-summary-badge {
  flex: 0 0 auto;
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
  background: var(--clean-accent-soft);
  color: var(--clean-accent);
  font-size: 0.72rem;
  font-weight: 800;
}

/* Panel body */
.clean-ui-v2 .model-refresh-body,
.clean-ui-v2 details > div:not(.json-output-wrap) {
  padding: 1rem;
}

/* Form grid */
.clean-ui-v2 .mlb-command-grid,
.clean-ui-v2 .control-grid,
.clean-ui-v2 .form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 0.85rem;
  align-items: end;
}

.clean-ui-v2 label.clean-field {
  display: grid;
  gap: 0.35rem;
  min-width: 0;
  color: var(--clean-muted);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.01em;
}

.clean-ui-v2 input,
.clean-ui-v2 select,
.clean-ui-v2 textarea {
  width: 100%;
  min-height: 2.65rem;
  border: 1px solid var(--clean-border);
  border-radius: 12px;
  padding: 0.55rem 0.75rem;
  background: #fff;
  color: var(--clean-text);
  font-size: 0.95rem;
  line-height: 1.3;
  box-sizing: border-box;
}

.clean-ui-v2 textarea {
  min-height: 6rem;
  resize: vertical;
}

.clean-ui-v2 input:focus,
.clean-ui-v2 select:focus,
.clean-ui-v2 textarea:focus {
  outline: 3px solid rgba(37, 99, 235, 0.16);
  border-color: var(--clean-accent);
}

/* Buttons */
.clean-ui-v2 .clean-actions,
.clean-ui-v2 .source-actions {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin: 0.9rem 0;
}

.clean-ui-v2 button,
.clean-ui-v2 .clean-button {
  min-height: 2.55rem;
  border: 1px solid rgba(37, 99, 235, 0.3);
  border-radius: 12px;
  padding: 0.55rem 0.9rem;
  background: var(--clean-accent);
  color: #fff;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 3px 10px rgba(37, 99, 235, 0.18);
}

.clean-ui-v2 button:hover {
  filter: brightness(0.96);
}

.clean-ui-v2 button:active {
  transform: translateY(1px);
}

.clean-ui-v2 button.secondary,
.clean-ui-v2 .source-actions button + button {
  background: #fff;
  color: var(--clean-accent);
  box-shadow: none;
}

/* Notes and status text */
.clean-ui-v2 .model-note,
.clean-ui-v2 .status,
.clean-ui-v2 [id$="Status"] {
  color: var(--clean-muted);
  line-height: 1.45;
}

/* Raw output cleanup */
.json-output-wrap {
  margin-top: 0.85rem;
  border: 1px solid var(--clean-border-soft);
  border-radius: 14px;
  overflow: hidden;
  background: #0f172a;
}

.json-output-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  padding: 0.55rem 0.75rem;
  background: #111827;
  color: #cbd5e1;
  font-size: 0.8rem;
  font-weight: 800;
}

.json-output-toolbar button {
  min-height: 1.85rem;
  padding: 0.25rem 0.55rem;
  border-radius: 8px;
  background: #1e293b;
  border-color: #334155;
  color: #e2e8f0;
  box-shadow: none;
  font-size: 0.75rem;
}

.clean-ui-v2 pre.json-output {
  margin: 0;
  max-height: 28rem;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-word;
  background: #0f172a;
  color: #e2e8f0;
  border: 0;
  border-radius: 0;
  padding: 0.85rem;
  font-size: 0.84rem;
  line-height: 1.45;
}

.clean-ui-v2 pre.json-output.is-compact {
  max-height: 3.25rem;
  opacity: 0.88;
}

/* Tables */
.clean-ui-v2 table {
  border-collapse: collapse;
}

.clean-ui-v2 th,
.clean-ui-v2 td {
  line-height: 1.35;
}

/* Left side / Start Here area */
.clean-left-rail {
  min-width: 280px;
  max-width: 420px;
  overflow-y: auto;
  overflow-x: hidden;
  resize: horizontal;
  scrollbar-gutter: stable;
}

.clean-left-rail * {
  overflow-wrap: anywhere;
}

.clean-left-rail input,
.clean-left-rail select,
.clean-left-rail button {
  max-width: 100%;
}

/* Prevent word cutoffs in cards/buttons */
.clean-ui-v2 button,
.clean-ui-v2 summary,
.clean-ui-v2 label,
.clean-ui-v2 input,
.clean-ui-v2 select {
  overflow-wrap: anywhere;
}

.clean-ui-v2 .prediction-table-scroll {
  border-radius: 14px;
}

/* Responsive */
@media (min-width: 1100px) {
  .workflow-dashboard .workflow-section-body,
  .workflow-predictor .workflow-section-body,
  .workflow-data .workflow-section-body {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .workflow-dashboard .workflow-section-body > details:first-child,
  .workflow-predictor .workflow-section-body > details:first-child {
    grid-column: 1 / -1;
  }
}

@media (max-width: 760px) {
  .workflow-section {
    padding: 0.7rem;
    border-radius: 18px;
  }

  .workflow-jump-nav {
    position: static;
  }

  .clean-ui-v2 .mlb-command-grid,
  .clean-ui-v2 .control-grid,
  .clean-ui-v2 .form-grid {
    grid-template-columns: 1fr;
  }

  .clean-ui-v2 .clean-actions,
  .clean-ui-v2 .source-actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .clean-left-rail {
    resize: none;
    max-width: 100%;
  }
}

