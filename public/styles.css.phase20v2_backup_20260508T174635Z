}

.muse-overview-hero-card h3,
.muse-overview-card h3 {
  margin: 0 0 0.65rem;
}

.muse-overview-hero-card h3 {
  font-size: clamp(1.35rem, 3vw, 2rem);
  line-height: 1;
  letter-spacing: -0.055em;
}

.muse-overview-hero-card p {
  margin: 0.35rem 0 0;
  color: #475569;
  font-weight: 750;
}

.muse-overview-pill {
  flex: 0 0 auto;
  padding: 0.45rem 0.75rem;
  border-radius: 999px;
  background: #eff6ff;
  color: #2563eb;
  font-weight: 950;
  white-space: nowrap;
}

.muse-overview-lines p {
  margin: 0.35rem 0;
  color: #334155;
  line-height: 1.45;
}

.muse-overview-stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(86px, 1fr));
  gap: 0.6rem;
}

.muse-overview-stat-grid div {
  border-radius: 14px;
  background: #f8fafc;
  padding: 0.7rem;
}

.muse-overview-stat-grid span {
  display: block;
  color: #64748b;
  font-size: 0.72rem;
  font-weight: 900;
  margin-bottom: 0.25rem;
}

.muse-overview-stat-grid strong {
  display: block;
  color: #0f172a;
  font-size: 1.1rem;
  letter-spacing: -0.03em;
}

.muse-overview-reads {
  margin: 0;
  padding-left: 1.25rem;
  color: #334155;
  line-height: 1.55;
}

@media (min-width: 860px) {
  .muse-overview-layout {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .muse-overview-hero-card,
  .muse-overview-wide {
    grid-column: 1 / -1;
  }
}

/* Muse Prop Edge tab */
.muse-prop-edge-layout {
  display: grid;
  gap: 0.9rem;
}

.muse-prop-edge-card {
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 1rem;
  background: white;
}

.muse-prop-edge-card h3 {
  margin: 0 0 0.75rem;
}

.muse-prop-edge-main {
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.10), transparent 22rem),
    #ffffff;
}

.muse-prop-edge-big {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 0.65rem;
}

.muse-prop-edge-big div {
  border-radius: 16px;
  background: #f8fafc;
  padding: 0.85rem;
}

.muse-prop-edge-big span {
  display: block;
  color: #64748b;
  font-size: 0.74rem;
  font-weight: 900;
  margin-bottom: 0.35rem;
}

.muse-prop-edge-big strong {
  display: block;
  color: #0f172a;
  font-size: clamp(1.35rem, 3vw, 2.1rem);
  letter-spacing: -0.055em;
}

.muse-edge-read {
  margin: 0.85rem 0 0;
  color: #334155;
  font-weight: 800;
}

.muse-adjustment-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 0.65rem;
}

.muse-adjustment-card {
  border-radius: 16px;
  background: #f8fafc;
  padding: 0.85rem;
}

.muse-adjustment-card span {
  display: block;
  color: #64748b;
  font-size: 0.74rem;
  font-weight: 900;
  margin-bottom: 0.25rem;
}

.muse-adjustment-card strong {
  display: block;
  font-size: 1.25rem;
  letter-spacing: -0.03em;
}

.muse-adjustment-card strong.positive {
  color: #2563eb;
}

.muse-adjustment-card strong.negative {
  color: #dc2626;
}

.muse-adjustment-card p {
  margin: 0.35rem 0 0;
  color: #64748b;
  line-height: 1.4;
  font-size: 0.85rem;
}

.muse-check-list,
.muse-warning-list {
  margin: 0;
  padding-left: 1.25rem;
  line-height: 1.55;
}

.muse-check-list li {
  color: #166534;
}

.muse-warning-list li {
  color: #92400e;
}

@media (min-width: 860px) {
  .muse-prop-edge-layout {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .muse-prop-edge-main {
    grid-column: 1 / -1;
  }
}

/* Muse Playerboard */
.muse-playerboard-card {
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  background: #fff;
  padding: 1rem;
}

.muse-playerboard-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 0.8rem;
}

.muse-playerboard-head h3 {
  margin: 0 0 0.25rem;
}

.muse-playerboard-head p {
  margin: 0;
  color: #64748b;
}

.muse-playerboard-table-wrap {
  overflow: auto;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
}

.muse-playerboard-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

.muse-playerboard-table th,
.muse-playerboard-table td {
  padding: 0.65rem 0.7rem;
  border-bottom: 1px solid #edf2f7;
  text-align: left;
  white-space: nowrap;
}

.muse-playerboard-table th {
  background: #f8fafc;
  color: #475569;
  font-size: 0.75rem;
  font-weight: 950;
  position: sticky;
  top: 0;
}

.muse-fill-prop {
  min-height: 2rem;
  border-radius: 999px;
  border: 1px solid #2563eb;
  background: #fff;
  color: #2563eb;
  padding: 0 0.7rem;
  font-weight: 900;
  cursor: pointer;
}

@media (max-width: 720px) {
  .muse-playerboard-head {
    display: grid;
  }
}

/* Top-level Playerboard */
.muse-top-playerboard {
  max-width: 920px;
  margin: 1rem auto 0;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  background: #ffffff;
  padding: 1rem;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
}

.muse-top-playerboard-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 0.85rem;
}

.muse-top-playerboard-head h2 {
  margin: 0 0 0.25rem;
  font-size: clamp(1.25rem, 2.5vw, 1.8rem);
  letter-spacing: -0.055em;
}

.muse-top-playerboard-head p {
  margin: 0;
  color: #64748b;
}

.muse-top-playerboard-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 140px;
  gap: 0.65rem;
  margin-bottom: 0.5rem;
}

.muse-top-playerboard-controls label {
  display: grid;
  gap: 0.25rem;
  color: #64748b;
  font-size: 0.76rem;
  font-weight: 900;
}

.muse-top-playerboard-controls input,
.muse-top-playerboard-controls select {
  min-height: 2.65rem;
  border: 1px solid #dbe4f0;
  border-radius: 14px;
  padding: 0 0.75rem;
  background: white;
  font-weight: 750;
}

@media (max-width: 720px) {
  .muse-top-playerboard-head {
    display: grid;
  }

  .muse-top-playerboard-controls {
    grid-template-columns: 1fr;
  }
}

/* Playerboard sorting and pagination */
.muse-top-playerboard-controls {
  grid-template-columns: minmax(0, 1fr) 180px 140px;
}

.muse-playerboard-pager {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem 0 0;
}

.muse-playerboard-pager button {
  min-height: 2.4rem;
  border-radius: 999px;
  border: 1px solid #2563eb;
  background: #ffffff;
  color: #2563eb;
  padding: 0 0.9rem;
  font-weight: 900;
  cursor: pointer;
}

.muse-playerboard-pager button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.muse-playerboard-pager span {
  color: #475569;
  font-weight: 800;
}

@media (max-width: 720px) {
  .muse-top-playerboard-controls {
    grid-template-columns: 1fr;
  }

  .muse-playerboard-pager {
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
  }
}

/* Keep UI clean: Playerboard is auto-saved in the background */
#topPlayerboardTrack,
.muse-track-prop {
  display: none !important;
}

.muse-board-actions {
  gap: 0;
}

/* Stage 1 product UX fixes: navigation, hierarchy, result cards, and safer raw output */
.app-pages-booting body {
  visibility: hidden;
}

.app-page-nav {
  justify-content: flex-start;
  border-radius: 24px;
}

.app-page-section-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(1.55rem, 2.6vw, 2.25rem);
  letter-spacing: -0.035em;
  line-height: 1.05;
}

.onboarding-card {
  display: grid;
  grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
  gap: 1rem;
  align-items: start;
  border: 1px solid rgba(15, 118, 110, 0.20);
  border-radius: 24px;
  padding: 1.15rem;
  background:
    radial-gradient(circle at top right, rgba(15, 118, 110, 0.12), transparent 22rem),
    linear-gradient(180deg, #ffffff 0%, #f5fbf9 100%);
  box-shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
}

.onboarding-card h2 {
  margin: 0.2rem 0 0.35rem;
  color: #0f172a;
  font-size: clamp(1.15rem, 2vw, 1.55rem);
}

.onboarding-card p {
  margin: 0;
  color: #64748b;
  line-height: 1.45;
}

.onboarding-card ol {
  display: grid;
  gap: 0.7rem;
  margin: 0;
  padding-left: 1.25rem;
}

.onboarding-card li {
  padding-left: 0.25rem;
  color: #0f172a;
  font-weight: 900;
}

.onboarding-card li span {
  display: block;
  margin-top: 0.15rem;
  color: #64748b;
  font-size: 0.9rem;
  font-weight: 650;
  line-height: 1.35;
}

.result-card {
  display: grid;
  gap: 1rem;
  margin: 0.75rem 0;
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 22px;
  padding: 1rem;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
}

.result-card-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: flex-start;
}

.result-card-header h3 {
  margin: 0.15rem 0 0.2rem;
  color: #0f172a;
  font-size: clamp(1.15rem, 2vw, 1.55rem);
  letter-spacing: -0.03em;
}

.result-card-header p:not(.eyebrow) {
  margin: 0;
  color: #64748b;
  font-weight: 700;
}

.result-rec,
.result-card-metric.confidence strong {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.42rem 0.7rem;
  font-size: 0.78rem;
  font-weight: 950;
  white-space: nowrap;
}

.result-rec.positive {
  color: #065f46;
  background: #d1fae5;
}

.result-rec.strong {
  color: #ffffff;
  background: #059669;
  box-shadow: 0 0 0 2px #047857;
}

.result-rec.avoid {
  color: #991b1b;
  background: #fee2e2;
}

.result-rec.neutral {
  color: #475569;
  background: #f1f5f9;
}

.result-card-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0.7rem;
}

.result-card-metric {
  display: grid;
  gap: 0.25rem;
  min-height: 88px;
  align-content: center;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 18px;
  padding: 0.8rem;
  background: #fff;
}

.result-card-metric span {
  color: #64748b;
  font-size: 0.75rem;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

.result-card-metric strong {
  color: #0f172a;
  font-size: clamp(1.1rem, 2.2vw, 1.55rem);
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
}

.result-card-metric.probability strong {
  color: #0f766e;
}

.result-card-metric.edge.strong strong {
  color: #065f46;
  font-weight: 950;
}

.result-card-metric.edge.positive strong,
.metric-positive {
  color: #047857 !important;
}

.result-card-metric.edge.negative strong,
.metric-negative {
  color: #b91c1c !important;
}

.result-card-metric.edge.neutral strong,
.metric-neutral {
  color: #64748b !important;
}

.result-card-metric.confidence.high strong,
.metric-high {
  color: #065f46 !important;
  background: #d1fae5;
}

.result-card-metric.confidence.medium strong,
.metric-medium {
  color: #92400e !important;
  background: #fef3c7;
}

.result-card-metric.confidence.low strong,
.metric-low {
  color: #475569 !important;
  background: #f1f5f9;
}

.result-card-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.result-card-notes span {
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 999px;
  padding: 0.35rem 0.55rem;
  color: #475569;
  background: #fff;
  font-size: 0.78rem;
  font-weight: 800;
}

/* Button hierarchy: one obvious CTA, useful secondary actions, muted diagnostics */
#simpleAnalyze,
#unifiedPredictButton,
#allDataPredictButton,
#propMlPredictButton,
#moneylinePredictButton,
#topPlayerboardLoad,
#dailyBeforeButton {
