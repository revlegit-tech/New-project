  gap: 0.8rem;
}

.app-page-section + .app-page-section {
  padding-top: 0.5rem;
}

.app-page-section-header {
  display: grid;
  gap: 0.25rem;
  padding: 0 0.2rem;
}

.app-page-section-header h2 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(1.15rem, 2vw, 1.55rem);
  letter-spacing: 0;
}

.app-page-section-header p {
  margin: 0;
  color: #64748b;
  line-height: 1.45;
}

.app-page-section-body {
  display: grid;
  gap: 0.85rem;
}

.app-page .panel,
.app-page details.model-refresh-panel {
  width: 100%;
  margin: 0;
}

.app-page .panel {
  box-shadow: 0 10px 32px rgba(15, 23, 42, 0.07);
}

.app-page .json-output-wrap {
  margin: 0;
}

.app-page-predictor .muse-app {
  margin-bottom: 0;
}

@media (max-width: 920px) {
  .muse-search-row {
    grid-template-columns: 1fr;
  }

  .muse-prop-controls {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .muse-big-answer {
    grid-template-columns: 1fr;
  }

  .muse-big-answer div {
    border-right: 0;
    border-bottom: 1px solid #edf2f7;
  }

  .muse-big-answer div:last-child {
    border-bottom: 0;
  }

  .muse-answer-header {
    display: grid;
  }

  .muse-pill {
    width: fit-content;
  }
}

@media (max-width: 560px) {
  .muse-prop-controls {
    grid-template-columns: 1fr;
  }

  .muse-actions {
    display: grid;
  }

  .muse-actions button {
    width: 100%;
  }

  .app-page-nav {
    position: static;
    border-radius: 22px;
  }

  .app-page-nav a {
    flex: 1 1 145px;
  }
