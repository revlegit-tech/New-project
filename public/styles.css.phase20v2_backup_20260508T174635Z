/* Immediate Muse UI fixes: tabs, placeholders, cleaner info density */
.muse-tabs {
  display: flex;
  gap: 0.4rem;
  padding: 0.85rem 1.25rem 0;
  overflow-x: auto;
  border-top: 1px solid #edf2f7;
}

.muse-tab {
  min-height: 2.4rem;
  border: 1px solid #dbe4f0;
  border-radius: 999px;
  background: #fff;
  color: #334155;
  padding: 0 0.85rem;
  font-weight: 900;
  white-space: nowrap;
  box-shadow: none;
}

.muse-tab.active {
  background: #0f172a;
  border-color: #0f172a;
  color: #fff;
}

.muse-tab-panels {
  padding: 1rem 1.25rem 1.25rem;
}

.muse-tab-panel {
  display: none;
}

.muse-tab-panel.active {
  display: block;
}

.muse-detail-grid ul {
  margin: 0;
  padding-left: 1.2rem;
}

.muse-detail-grid li {
  margin: 0.25rem 0;
}

.muse-detail-grid p {
  word-break: normal;
  overflow-wrap: anywhere;
}

.muse-autofill-summary strong {
  font-size: 1rem;
}

.muse-autofill-summary span {
  color: #334155;
}

.muse-prop-controls input::placeholder {
  color: #94a3b8;
}

.muse-answer-card .muse-detail-grid h3 {
  font-size: 1rem;
}

/* Muse Recent Form and Game Logs */
.muse-recent-stack {
  display: grid;
  gap: 0.85rem;
}

.muse-statline {
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 0.95rem;
  background: white;
}

.muse-statline h3 {
  margin: 0 0 0.75rem;
}

.muse-stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(95px, 1fr));
  gap: 0.65rem;
}

.muse-stat-grid div {
  border-radius: 14px;
  background: #f8fafc;
  padding: 0.7rem;
}

.muse-stat-grid span {
  display: block;
  color: #64748b;
  font-size: 0.72rem;
  font-weight: 900;
  margin-bottom: 0.25rem;
}

.muse-stat-grid strong {
  display: block;
  color: #0f172a;
  font-size: 1.2rem;
  letter-spacing: -0.03em;
}

.muse-log-table-wrap {
  overflow: auto;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  background: white;
}

.muse-log-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.muse-log-table th,
.muse-log-table td {
  padding: 0.65rem 0.75rem;
  border-bottom: 1px solid #edf2f7;
  text-align: left;
  white-space: nowrap;
}

.muse-log-table th {
  position: sticky;
  top: 0;
  background: #f8fafc;
  color: #475569;
  font-size: 0.78rem;
  font-weight: 950;
}

.muse-empty-mini {
  padding: 1rem;
  border: 1px dashed #cbd5e1;
  border-radius: 18px;
  color: #64748b;
  background: #f8fafc;
}

/* Muse Statcast cards */
.muse-statcast-layout {
  display: grid;
  gap: 0.9rem;
}

.muse-statcast-card {
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 0.95rem;
  background: #fff;
}

.muse-statcast-card h3 {
  margin: 0 0 0.75rem;
}

.muse-mini-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(115px, 1fr));
  gap: 0.65rem;
}

.muse-mini-metric {
  border-radius: 14px;
  background: #f8fafc;
  padding: 0.75rem;
}

.muse-mini-metric span {
  display: block;
  color: #64748b;
  font-size: 0.72rem;
  font-weight: 900;
  margin-bottom: 0.25rem;
}

.muse-mini-metric strong {
  display: block;
  color: #0f172a;
  font-size: 1.18rem;
  letter-spacing: -0.03em;
}

.muse-mini-metric em {
  display: block;
  margin-top: 0.2rem;
  color: #64748b;
  font-size: 0.75rem;
