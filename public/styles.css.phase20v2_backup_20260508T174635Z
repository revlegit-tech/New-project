}

@media (max-width: 920px) {
  .onboarding-card,
  .result-card-grid {
    grid-template-columns: 1fr;
  }

  .result-card-header {
    display: grid;
  }
}

/* Stage 2 product polish: daily runbook hero, actionable empty states, and tracker context */
.stage2-daily-runbook,
.stage2-my-picks-hero,
.stage2-empty-state {
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 24px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  box-shadow: 0 16px 42px rgba(15, 23, 42, 0.08);
}

.stage2-daily-runbook {
  display: grid;
  gap: 1rem;
  padding: 1rem;
  margin-bottom: 1rem;
}

.stage2-runbook-hero,
.stage2-my-picks-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}

.stage2-runbook-hero h2,
.stage2-my-picks-hero h2 {
  margin: 0.15rem 0 0.35rem;
  color: #0f172a;
  font-size: clamp(1.25rem, 2.4vw, 1.9rem);
  letter-spacing: -0.045em;
  line-height: 1.05;
}

.stage2-runbook-hero p,
.stage2-my-picks-hero p,
.stage2-empty-state p {
  margin: 0;
  color: #64748b;
  line-height: 1.45;
  font-weight: 650;
}

.stage2-runbook-date {
  min-width: 150px;
  border: 1px solid rgba(15, 118, 110, 0.18);
  border-radius: 18px;
  padding: 0.8rem;
  background: #f0fdfa;
}

.stage2-runbook-date span,
.stage2-runbook-metrics span,
.stage2-my-picks-strip span {
  display: block;
  color: #64748b;
  font-size: 0.72rem;
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.stage2-runbook-date strong,
.stage2-runbook-metrics strong,
.stage2-my-picks-strip strong {
  display: block;
  color: #0f172a;
  font-size: 1.25rem;
  letter-spacing: -0.035em;
  font-variant-numeric: tabular-nums;
}

.stage2-runbook-steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.7rem;
}

.stage2-runbook-step {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.6rem;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 0.85rem;
  background: #ffffff;
}

.stage2-step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 999px;
  color: #475569;
  background: #f1f5f9;
  font-weight: 950;
}

.stage2-runbook-step strong {
  display: block;
  color: #0f172a;
  line-height: 1.15;
}

.stage2-runbook-step p {
  margin: 0.25rem 0 0;
  color: #64748b;
  font-size: 0.82rem;
  line-height: 1.35;
}

.stage2-runbook-step.is-done {
  border-color: rgba(5, 150, 105, 0.28);
  background: #f0fdf4;
}

.stage2-runbook-step.is-done .stage2-step-icon {
  color: #065f46;
  background: #d1fae5;
}

.stage2-runbook-step.is-warning {
  border-color: rgba(217, 119, 6, 0.32);
  background: #fffbeb;
}

.stage2-runbook-step.is-warning .stage2-step-icon {
  color: #92400e;
  background: #fef3c7;
}

.stage2-runbook-step.is-active {
  border-color: rgba(15, 118, 110, 0.32);
  box-shadow: inset 0 0 0 1px rgba(15, 118, 110, 0.12);
}

.stage2-runbook-step.is-active .stage2-step-icon {
  color: #0f766e;
  background: #ccfbf1;
}

.stage2-runbook-metrics,
.stage2-my-picks-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.7rem;
}

.stage2-runbook-metrics div,
.stage2-my-picks-strip div {
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 0.75rem;
  background: #ffffff;
}

.stage2-runbook-metrics small {
  display: block;
  color: #64748b;
  font-size: 0.75rem;
  margin-top: 0.15rem;
}

.stage2-runbook-actions,
.stage2-onboarding-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.stage2-runbook-actions button,
.stage2-onboarding-actions button {
  width: auto;
  min-height: 42px;
  border-radius: 14px;
  padding: 0 0.9rem;
  font-weight: 950;
}

.stage2-primary-action,
.stage2-onboarding-actions [data-stage2-go-runbook] {
  border: 1px solid var(--accent);
  color: #ffffff;
  background: var(--accent);
  box-shadow: 0 12px 22px rgba(15, 118, 110, 0.18);
}

.stage2-secondary-action {
  border: 1px solid rgba(15, 118, 110, 0.42);
  color: var(--accent-dark);
  background: #ffffff;
  box-shadow: none;
}

.stage2-ghost-action,
.stage2-onboarding-actions [data-stage2-dismiss-onboarding] {
  border: 1px solid rgba(148, 163, 184, 0.4);
  color: #475569;
  background: #f8fafc;
  box-shadow: none;
}

.stage2-empty-state {
  display: grid;
  gap: 0.25rem;
  margin-top: 0.8rem;
  padding: 1rem;
  border-style: dashed;
  box-shadow: none;
}

.stage2-empty-state strong {
  color: #0f172a;
  font-size: 1rem;
}

.stage2-skeleton-list {
  display: grid;
  gap: 0.6rem;
  margin-top: 0.9rem;
}

.stage2-skeleton-row {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr 0.6fr 0.4fr;
  gap: 0.7rem;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 0.8rem;
  background: #fff;
}

.stage2-skeleton-row span {
  height: 1rem;
  border-radius: 999px;
  background: linear-gradient(90deg, #e2e8f0, #f8fafc, #e2e8f0);
  background-size: 200% 100%;
  animation: stage2-shimmer 1.25s linear infinite;
}

@keyframes stage2-shimmer {
  to { background-position: -200% 0; }
}

.stage2-my-picks-hero {
  padding: 1rem;
  margin-bottom: 0.9rem;
}

.stage2-my-picks-strip {
  min-width: min(520px, 100%);
}

.stage2-raw-label {
  width: fit-content;
  margin: 0.85rem 0 0.35rem;
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 999px;
  padding: 0.25rem 0.55rem;
  color: #64748b;
  background: #f8fafc;
  font-size: 0.72rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

@media (max-width: 920px) {
  .stage2-runbook-hero,
  .stage2-my-picks-hero,
  .stage2-runbook-steps,
  .stage2-runbook-metrics,
  .stage2-my-picks-strip,
  .stage2-skeleton-row {
    grid-template-columns: 1fr;
  }

  .stage2-runbook-hero,
  .stage2-my-picks-hero {
    display: grid;
  }
}

/* Stage 3 betting UX: Kelly sizing, line shopping, steam alerts, and P&L analytics */
.stage3-addons,
.stage3-split-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 1rem 0;
}

.stage3-card,
.stage3-chart-card,
.stage3-steam-alert,
.stage3-empty-state,
.stage3-loading {
  background: var(--panel, #fff);
  border: 1px solid var(--line, #d9e2df);
  border-radius: 18px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  padding: 1rem;
}

.stage3-card-header {
  align-items: start;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.stage3-card-header.compact { margin-bottom: .7rem; }
.stage3-card-header h3 { margin: .1rem 0 .25rem; }
.stage3-card-header p { color: var(--muted, #64748b); margin: 0; }

.stage3-bankroll-input {
  color: var(--muted, #64748b);
  font-size: .82rem;
  min-width: 130px;
}

.stage3-bankroll-input input { margin-top: .35rem; }

.stage3-kelly-grid,
.stage3-pnl-grid {
  display: grid;
  gap: .75rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.stage3-pnl-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 1rem; }

.stage3-kelly-grid div,
.stage3-pnl-grid div {
  background: rgba(15, 118, 110, .06);
  border: 1px solid rgba(15, 118, 110, .16);
  border-radius: 14px;
  padding: .85rem;
}

.stage3-kelly-grid span,
.stage3-pnl-grid span,
.stage3-kelly-grid small,
.stage3-pnl-grid small {
  color: var(--muted, #64748b);
  display: block;
  font-size: .78rem;
}

.stage3-kelly-grid strong,
.stage3-pnl-grid strong {
  display: block;
  font-size: 1.35rem;
  margin: .2rem 0;
}

.stage3-table-wrap { overflow-x: auto; }
.stage3-table { border-collapse: collapse; width: 100%; }
.stage3-table th,
.stage3-table td {
  border-bottom: 1px solid var(--line, #d9e2df);
  padding: .55rem .45rem;
  text-align: left;
  white-space: nowrap;
}
.stage3-table tr.is-best td { background: rgba(231, 244, 235, .88); font-weight: 700; }
.stage3-table .positive,
.stage3-pnl-grid .positive { color: #047857; }
.stage3-table .negative,
.stage3-pnl-grid .negative { color: #b91c1c; }

.stage3-steam-toolbar {
  align-items: end;
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  margin-bottom: 1rem;
}
.stage3-steam-toolbar label { min-width: 170px; }
.stage3-steam-toolbar button { width: auto; }

.stage3-steam-list {
  display: grid;
  gap: .75rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.stage3-steam-alert {
  border-left: 5px solid #94a3b8;
  display: grid;
  gap: .65rem;
}
.stage3-steam-alert.steam { border-left-color: #0f766e; }
.stage3-steam-alert.drift { border-left-color: #c98a1d; }
.stage3-steam-alert strong,
.stage3-steam-alert span,
.stage3-steam-alert small { display: block; }
.stage3-steam-alert span,
.stage3-steam-alert small,
.stage3-steam-alert p { color: var(--muted, #64748b); }
.stage3-steam-alert p { margin: 0; }
.stage3-steam-move {
  background: rgba(15, 118, 110, .06);
  border-radius: 12px;
  padding: .65rem;
}

.stage3-sparkline {
  background: linear-gradient(180deg, rgba(15,118,110,.06), rgba(15,118,110,.01));
  border: 1px solid var(--line, #d9e2df);
  border-radius: 16px;
  height: 180px;
  width: 100%;
}
.stage3-sparkline polyline {
  fill: none;
  stroke: currentColor;
  stroke-width: 3;
  vector-effect: non-scaling-stroke;
}
.stage3-warning-list {
  display: grid;
  gap: .6rem;
}
.stage3-warning-list article {
  border: 1px solid var(--line, #d9e2df);
  border-radius: 12px;
  padding: .7rem;
}
.stage3-warning-list span { color: var(--muted, #64748b); display: block; }

@media (max-width: 860px) {
  .stage3-addons,
  .stage3-split-grid,
  .stage3-steam-list,
  .stage3-kelly-grid,
  .stage3-pnl-grid {
    grid-template-columns: 1fr;
  }
  .stage3-card-header { display: block; }
}

/* Stage 4 active-bet context strip and collapsible secondary sections */
.active-bet-strip {
  position: sticky;
  top: 4.35rem;
  z-index: 45;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .5rem;
  width: min(1120px, 100%);
  margin: -0.35rem auto 1rem;
  padding: .55rem .7rem;
  border: 1px solid #dbe7e3;
  border-radius: 18px;
  background: rgba(248, 250, 252, .96);
  box-shadow: 0 10px 24px rgba(15, 23, 42, .07);
  backdrop-filter: blur(10px);
}

.active-bet-strip-label {
  color: #64748b;
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.active-bet-strip button {
  display: inline-grid;
  gap: .08rem;
  min-width: 104px;
  border: 1px solid #d9e2df;
  border-radius: 14px;
  padding: .4rem .58rem;
  background: #fff;
  color: #0f172a;
  text-align: left;
  cursor: pointer;
}

.active-bet-strip button:hover {
  border-color: #0f766e;
  box-shadow: 0 0 0 3px rgba(15, 118, 110, .12);
}

.active-bet-strip button span {
  color: #64748b;
  font-size: .68rem;
  font-weight: 850;
  text-transform: uppercase;
}

.active-bet-strip button strong {
  overflow: hidden;
  max-width: 180px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage3-collapsible-section > summary {
  cursor: pointer;
  list-style: none;
}

.stage3-collapsible-section > summary::-webkit-details-marker { display: none; }

.stage3-collapsible-summary {
  display: grid;
  gap: .25rem;
}

.stage3-summary-title {
  color: #0f172a;
  font-size: clamp(1.25rem, 2vw, 1.8rem);
  font-weight: 950;
  letter-spacing: -.03em;
}

.stage3-single-book-note,
.stage3-load-card p { margin-top: .35rem; }

.stage3-load-card button { margin-top: .75rem; width: auto; }

/* Trust Surface: premium bettor-facing status banner */
.trust-surface {
  margin: 0 0 18px;
  padding: 16px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 22px;
  background:
    radial-gradient(circle at top left, rgba(212, 175, 55, 0.16), transparent 34%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(2, 6, 23, 0.96));
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.34);
  color: #e5e7eb;
}

.trust-surface.is-good {
  border-color: rgba(34, 197, 94, 0.34);
}

.trust-surface.is-partial {
  border-color: rgba(245, 158, 11, 0.38);
}

.trust-surface.is-bad {
  border-color: rgba(248, 113, 113, 0.42);
}

.trust-surface-main {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  justify-content: space-between;
}

.trust-surface-main strong {
  display: block;
  font-size: 0.98rem;
  letter-spacing: -0.01em;
}

.trust-surface-main p,
.trust-surface-warning {
  margin: 4px 0 0;
  color: rgba(226, 232, 240, 0.74);
  font-size: 0.86rem;
  line-height: 1.45;
}

.trust-mode-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(212, 175, 55, 0.16);
  color: #facc15;
  border: 1px solid rgba(250, 204, 21, 0.28);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.68rem;
  font-weight: 800;
  white-space: nowrap;
}

.trust-surface-metrics {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
  margin: 14px 0 0;
}

.trust-surface-metrics div {
  min-width: 0;
  padding: 10px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.14);
}

.trust-surface-metrics dt {
  margin: 0 0 4px;
  color: rgba(148, 163, 184, 0.9);
  font-size: 0.67rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.trust-surface-metrics dd {
  margin: 0;
  color: #f8fafc;
  font-size: 0.82rem;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trust-surface-warning {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

@media (max-width: 920px) {
  .trust-surface-main {
    flex-direction: column;
  }

  .trust-surface-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Stage: Prop Card Redesign + Model Cards */
.model-room-panel {
  border-color: rgba(125, 211, 252, 0.28);
  background: linear-gradient(180deg, rgba(9, 18, 36, 0.96), rgba(7, 12, 26, 0.98));
}

.model-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
  margin-top: 14px;
}

.model-card,
.premium-prop-card {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 22px;
  background:
    radial-gradient(circle at top left, rgba(14, 165, 233, 0.12), transparent 34%),
    linear-gradient(180deg, rgba(15, 23, 42, 0.98), rgba(2, 6, 23, 0.98));
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.32);
}

.model-card {
