/* Resizable wide workflow layout */
:root {
  --controls-width: 560px;
}

.workspace {
  grid-template-columns: minmax(420px, var(--controls-width)) 8px minmax(520px, 1fr) !important;
  gap: 0.75rem !important;
  align-items: start;
}

.panel.controls {
  min-width: 0;
  width: 100%;
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 0.85rem;
  scrollbar-gutter: stable;
}

.results {
  min-width: 0;
  width: 100%;
}

.layout-resize-handle {
  width: 8px;
  min-height: calc(100vh - 2rem);
  align-self: stretch;
  border-radius: 999px;
  cursor: col-resize;
  background: linear-gradient(
    to bottom,
    rgba(125, 211, 252, 0.18),
    rgba(255, 255, 255, 0.06)
  );
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.layout-resize-handle:hover,
.is-resizing-layout .layout-resize-handle {
  background: rgba(125, 211, 252, 0.28);
}

.is-resizing-layout {
  cursor: col-resize;
  user-select: none;
}

.layout-width-controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.55rem;
}

.layout-width-controls button {
  min-height: 2.4rem;
  white-space: normal;
  line-height: 1.2;
}

/* Prevent text cutoffs/clipping */
button,
select,
input,
summary,
label,
.model-note,
.json-output,
.seamless-card,
.seamless-card *,
.all-data-step,
.all-data-step * {
  overflow-wrap: anywhere;
  word-break: normal;
}

button {
  white-space: normal !important;
  line-height: 1.22 !important;
  min-height: 2.65rem;
  padding-top: 0.65rem;
  padding-bottom: 0.65rem;
}

summary {
  white-space: normal !important;
  line-height: 1.25 !important;
}

label {
  min-width: 0;
}

input,
select,
textarea {
  min-width: 0;
  width: 100%;
  text-overflow: ellipsis;
}

select {
  min-height: 2.75rem;
  line-height: 1.25;
}

.source-actions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) !important;
  gap: 0.65rem;
}

.stat-grid,
.matchup-grid {
  grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)) !important;
}

.stat-grid div,
.matchup-grid div {
  min-width: 0;
  overflow: hidden;
}

.stat-grid span,
.matchup-grid span {
  display: block;
  white-space: normal;
  line-height: 1.2;
}

.stat-grid strong,
.matchup-grid strong {
  display: block;
  white-space: normal;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

/* Better All Data predictor readability */
.all-data-two-col {
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) !important;
}

.all-data-main-actions {
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) !important;
}

.all-data-main-actions .secondary-action {
  grid-column: auto !important;
}

.all-data-step {
  gap: 0.9rem;
}

.all-data-step-header {
  align-items: center;
}

.all-data-step-badge {
  flex: 0 0 2rem;
}

.all-data-step-body {
