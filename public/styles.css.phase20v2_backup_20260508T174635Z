/* Player Prop ML autocomplete */
.propml-autocomplete-wrap {
  position: relative;
}

.propml-autocomplete-results {
  position: absolute;
  z-index: 1000;
  left: 0;
  right: 0;
  top: calc(100% + 0.35rem);
  max-height: 18rem;
  overflow-y: auto;
  border-radius: 16px;
  border: 1px solid rgba(125, 211, 252, 0.24);
  background: rgba(10, 18, 32, 0.98);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.32);
  padding: 0.35rem;
}

.propml-autocomplete-results.hidden {
  display: none;
}

.propml-autocomplete-item {
  width: 100%;
  border: 0;
  background: transparent;
  color: inherit;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.5rem;
  align-items: center;
  text-align: left;
  padding: 0.65rem 0.75rem;
  border-radius: 12px;
  min-height: auto;
}

.propml-autocomplete-item:hover,
.propml-autocomplete-item:focus {
  background: rgba(125, 211, 252, 0.14);
  outline: none;
}

.propml-autocomplete-item strong {
  overflow-wrap: anywhere;
  line-height: 1.2;
}

.propml-autocomplete-item span {
  opacity: 0.72;
  font-size: 0.82rem;
  white-space: nowrap;
}

.propml-autocomplete-empty {
  padding: 0.75rem;
  opacity: 0.72;
  font-size: 0.9rem;
}

.propml-autocomplete-hint {
  border: 1px solid rgba(125, 211, 252, 0.18);
  border-radius: 14px;
  padding: 0.75rem;
  background: rgba(125, 211, 252, 0.06);
}

