:root {
  color-scheme: light;
  --ink: #17212b;
  --muted: #617083;
  --line: #dce3ea;
  --field: #f7f9fb;
  --panel: #ffffff;
  --border-color: var(--line);
  --panel-background: var(--panel);
  --accent: #0f766e;
  --accent-dark: #0b5f59;
  --gold: #c98a1d;
  --grass: #e7f4eb;
  --sky: #e8f2ff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    linear-gradient(135deg, rgba(15, 118, 110, 0.12), rgba(201, 138, 29, 0.1)),
    #f6f8f5;
}

button,
input,
select {
  font: inherit;
}

.app-shell {
  width: min(1180px, calc(100vw - 32px));
  margin: 0 auto;
  padding: 32px 0;
}

.workspace {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

.panel,
.scoreboard {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  box-shadow: 0 18px 55px rgba(23, 33, 43, 0.08);
}

.controls {
  position: sticky;
  top: 20px;
  display: grid;
  gap: 18px;
  padding: 22px;
}

.eyebrow {
  margin: 0 0 5px;
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2 {
  margin: 0;
  letter-spacing: 0;
}

h1 {
  font-size: 2.1rem;
}

h2 {
  font-size: 1.25rem;
}

label {
  display: grid;
  gap: 7px;
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 700;
}

select,
input[type="search"],
input[type="number"],
input[type="url"],
input[type="date"],
input[type="text"],
textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--ink);
  background: var(--field);
}

select,
input[type="search"],
input[type="number"],
input[type="url"],
input[type="date"],
input[type="text"] {
  min-height: 42px;
  padding: 0 12px;
}

textarea {
  min-height: 112px;
  resize: vertical;
  padding: 10px 12px;
  line-height: 1.35;
}

.search-results {
  display: grid;
  gap: 6px;
  max-height: 188px;
  overflow: auto;
}

.search-option {
  min-height: 40px;
  display: grid;
  align-content: center;
  gap: 2px;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 8px 10px;
  color: var(--ink);
  background: var(--field);
  cursor: pointer;
}

.search-option:hover,
.search-option.selected {
  border-color: rgba(15, 118, 110, 0.44);
  background: #edf7f4;
}

.search-option strong {
  font-size: 0.86rem;
}

.search-option span {
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 750;
}

input[type="range"] {
  accent-color: var(--accent);
}

.upload-zone {
  min-height: 104px;
  border: 1px dashed #9fb1bf;
  border-radius: 8px;
  padding: 16px;
  justify-content: center;
  color: var(--ink);
  background: var(--sky);
  cursor: pointer;
}

.upload-zone span {
  color: var(--accent-dark);
  font-weight: 800;
}

.upload-zone strong {
  color: var(--muted);
  font-size: 0.86rem;
}

.upload-zone input {
  display: none;
}

.dataset-helper {
  display: grid;
  gap: 8px;
  border-left: 3px solid var(--accent);
  border-radius: 6px;
  padding: 10px 12px;
  background: #edf7f4;
}

.dataset-helper div {
  display: grid;
  gap: 3px;
}

.dataset-helper strong {
  color: var(--ink);
  font-size: 0.9rem;
}

.dataset-helper span,
.dataset-helper p {
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 700;
  line-height: 1.35;
}

.dataset-helper p {
  margin: 0;
}

.dataset-guide {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--field);
  overflow: hidden;
}

.data-manager {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--field);
  overflow: hidden;
}

.data-manager summary,
.model-refresh-panel summary {
  min-height: 42px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  color: var(--accent-dark);
  font-size: 0.86rem;
  font-weight: 850;
  cursor: pointer;
}

.data-manager-body {
  display: grid;
  gap: 14px;
  border-top: 1px solid var(--line);
  padding: 14px;
}

.model-refresh-panel {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--field);
  overflow: hidden;
}

.model-refresh-body {
  display: grid;
  gap: 12px;
  border-top: 1px solid var(--line);
  padding: 14px;
}

.model-refresh-body button {
  min-height: 40px;
}

.refresh-results {
  display: grid;
  gap: 8px;
}

.refresh-result {
  display: grid;
  gap: 4px;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 10px;
  background: #fff;
}

.refresh-result.loaded {
  border-color: rgba(15, 118, 110, 0.34);
  background: #edf7f4;
}

.refresh-result.error {
  border-color: rgba(188, 71, 73, 0.34);
  background: #fff4f2;
}

.refresh-result strong {
  color: var(--ink);
  font-size: 0.82rem;
}

.refresh-result span {
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 750;
  line-height: 1.35;
}

.dataset-guide summary {
  min-height: 38px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  color: var(--accent-dark);
  font-size: 0.84rem;
  font-weight: 850;
  cursor: pointer;
}

.dataset-guide-list {
  display: grid;
  gap: 0;
  border-top: 1px solid var(--line);
}

.dataset-guide-item {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  cursor: pointer;
}

.dataset-guide-item:last-child {
  border-bottom: 0;
}

.dataset-guide-item:hover,
.dataset-guide-item.selected {
  background: #edf7f4;
}

.dataset-guide-item strong {
  color: var(--ink);
  font-size: 0.82rem;
}

.dataset-guide-item span,
.dataset-guide-item em {
  color: var(--muted);
  font-size: 0.76rem;
  font-style: normal;
  font-weight: 700;
  line-height: 1.3;
}

.dataset-guide-item em {
  color: #748395;
}

.url-import {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 108px;
  gap: 10px;
  align-items: end;
}

.url-import button {
  min-height: 42px;
}

.bulk-url-panel {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--field);
  overflow: hidden;
}

.bulk-url-panel summary {
  min-height: 38px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  color: var(--accent-dark);
  font-size: 0.84rem;
  font-weight: 850;
  cursor: pointer;
}

.bulk-url-panel label {
  padding: 0 12px 12px;
}

.bulk-url-panel button {
  width: calc(100% - 24px);
  min-height: 38px;
  margin: 0 12px 12px;
}

.source-actions {
  display: grid;
}

.source-actions button {
  min-height: 38px;
}

.source-list {
  display: grid;
  gap: 8px;
}

.source-empty {
  border: 1px dashed var(--line);
  border-radius: 6px;
  padding: 10px;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 800;
  text-align: center;
}

.source-pill {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 78px;
  gap: 10px;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 10px;
  background: var(--field);
}

.source-pill.loaded {
  border-color: rgba(15, 118, 110, 0.34);
  background: #edf7f4;
}

.source-pill.error {
  border-color: rgba(188, 71, 73, 0.34);
  background: #fff4f2;
}

.source-copy {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.source-copy strong {
  color: var(--ink);
  font-size: 0.84rem;
}

.source-copy span {
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 750;
}

.source-copy .source-url {
  overflow-wrap: anywhere;
  color: var(--accent-dark);
}

.source-pill button {
  min-height: 34px;
  font-size: 0.78rem;
}

.dataset-list {
  display: grid;
  gap: 8px;
}

.dataset-pill {
  display: flex;
  min-height: 42px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 8px 10px;
  background: var(--field);
}

.dataset-pill span {
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 800;
}

.dataset-pill strong {
  color: #8794a3;
  font-size: 0.82rem;
}

.dataset-pill.loaded {
  border-color: rgba(15, 118, 110, 0.34);
  background: #edf7f4;
}

.dataset-pill.loaded strong {
  color: var(--accent-dark);
}

.range-readout {
  color: var(--muted);
  font-size: 0.86rem;
  font-weight: 600;
}

.inline-check {
  display: flex;
  grid-template-columns: none;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 800;
}

.inline-check input {
  width: 16px;
  height: 16px;
  accent-color: var(--accent);
}

button {
  min-height: 46px;
  border: 0;
  border-radius: 6px;
  color: white;
  background: var(--accent);
  font-weight: 850;
  cursor: pointer;
}

button:hover {
  background: var(--accent-dark);
}

button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.search-option,
.search-option:hover {
  color: var(--ink);
  background: var(--field);
  text-align: left;
}

.search-option:hover,
.search-option.selected {
  background: #edf7f4;
}

a {
  color: var(--accent-dark);
  font-weight: 800;
}

.results {
  display: grid;
  gap: 18px;
}

.scoreboard {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
}

.scoreboard div {
  min-height: 122px;
  display: grid;
  align-content: center;
  gap: 8px;
  padding: 20px;
  border-right: 1px solid var(--line);
  background: linear-gradient(180deg, #ffffff, var(--grass));
}

.scoreboard div:last-child {
  border-right: 0;
}

.scoreboard span,
.stat-grid span {
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 750;
  text-transform: uppercase;
}

.scoreboard strong {
  font-size: 2rem;
  letter-spacing: 0;
}

.detail-panel {
  display: grid;
  gap: 20px;
  padding: 22px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.stat-grid div {
  min-height: 76px;
  display: grid;
  align-content: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 12px;
  background: var(--field);
}

.stat-grid strong {
  font-size: 1.08rem;
}

.model-note {
  margin: 0;
  color: var(--muted);
  line-height: 1.5;
}

.hidden {
  display: none !important;
}

.matchup-panel {
  display: grid;
  gap: 0;
  overflow: hidden;
}

.recent-panel,
.hr-panel,
.team-matchup-panel,
.pitcher-profile-panel {
  overflow: hidden;
}

.matchup-panel .stat-grid,
.matchup-panel .model-note,
.strikeout-panel .stat-grid,
.strikeout-panel .model-note,
.team-matchup-panel .stat-grid,
.team-matchup-panel .model-note,
.recent-panel .stat-grid,
.recent-panel .model-note,
.hr-panel .stat-grid,
.pitcher-profile-panel .stat-grid,
.pitcher-profile-panel .model-note {
  margin: 18px 20px;
}

.recent-lookup {
  padding: 0 20px 18px;
}

.recent-games-table {
  margin: 0 20px 20px;
  border: 1px solid var(--line);
  border-radius: 6px;
}

.strikeout-panel {
  overflow: hidden;
}

.compact-table {
  max-height: 280px;
}

.matchup-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.needs-panel {
  overflow: hidden;
}

.github-panel {
  overflow: hidden;
}

.prop-board-panel {
  overflow: hidden;
}

.mlb-panel {
  overflow: hidden;
}

.espn-panel {
  overflow: hidden;
}

.probables-cell {
  min-width: 190px;
}

.probables-cell span {
  display: block;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 750;
}

.probables-cell span + span {
  margin-top: 4px;
}

.mini-actions {
  display: flex;
  gap: 6px;
}

.mini-button {
  min-height: 30px;
  border-radius: 5px;
  padding: 0 9px;
  font-size: 0.78rem;
}

.github-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150px;
  gap: 12px;
  align-items: end;
  padding: 18px 20px 0;
}

.prop-board-controls {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) 150px 130px 150px;
  gap: 12px;
  align-items: end;
  padding: 18px 20px 0;
}

.prop-board-text {
  padding: 18px 20px 0;
}

.prop-board-text textarea {
  min-height: 148px;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: 0.82rem;
}

.mlb-panel .github-controls {
  grid-template-columns: minmax(0, 1fr) 120px 150px;
}

.espn-controls {
  display: grid;
  grid-template-columns: 150px 150px minmax(0, 1fr) 150px;
  gap: 12px;
  align-items: end;
  padding: 18px 20px 0;
}

.github-summary {
  display: grid;
  gap: 6px;
  padding: 18px 20px;
}

.mlb-panel .stat-grid,
.espn-panel .stat-grid {
  margin: 0 20px 20px;
}

.mlb-command-shell {
  border-top: 1px solid var(--line);
}

.compact-header {
  padding-block: 14px;
}

.mlb-command-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  padding: 18px 20px;
}

.mlb-command-grid button {
  align-self: end;
}

.json-output {
  max-height: 360px;
  margin: 0 20px 20px;
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 14px;
  color: #1f2933;
  background: #f7f9fb;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: 0.82rem;
  line-height: 1.45;
  white-space: pre-wrap;
}

.needs-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  padding: 20px;
}

.needs-columns ul {
  display: grid;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.needs-columns li {
  display: grid;
  gap: 4px;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 11px;
  color: var(--muted);
  background: var(--field);
  line-height: 1.35;
}

.needs-columns li strong {
  color: var(--ink);
}

.needs-columns li span {
  font-size: 0.88rem;
}

.table-panel {
  overflow: hidden;
}

.table-header {
  display: flex;
  gap: 12px;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  border-bottom: 1px solid var(--line);
}

.table-header input {
  max-width: 250px;
}

.table-header select {
  width: auto;
  min-width: 128px;
}

.table-wrap {
  max-height: 430px;
  overflow: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.92rem;
}

th,
td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  white-space: nowrap;
}

th {
  position: sticky;
  top: 0;
  background: #f3f7f6;
  color: var(--muted);
  font-size: 0.78rem;
  text-transform: uppercase;
}

.sort-header {
  min-height: auto;
  border: 0;
  padding: 0;
  color: inherit;
  background: transparent;
  font: inherit;
  text-align: left;
  text-transform: inherit;
}

.sort-header:hover {
  color: var(--accent-dark);
  background: transparent;
}

.sort-header.active::after {
  content: attr(data-direction);
  margin-left: 6px;
  color: var(--accent-dark);
  font-weight: 900;
}

tbody tr {
  cursor: pointer;
}

tbody tr:hover,
tbody tr.selected {
  background: #edf7f4;
}

@media (max-width: 900px) {
  .workspace,
  .scoreboard,
  .stat-grid,
  .needs-columns {
    grid-template-columns: 1fr;
  }

  .controls {
    position: static;
  }

  .url-import {
    grid-template-columns: 1fr;
  }

  .scoreboard div {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .table-header {
    align-items: stretch;
    flex-direction: column;
  }

  .github-controls {
    grid-template-columns: 1fr;
  }

  .prop-board-controls {
    grid-template-columns: 1fr;
  }

  .mlb-panel .github-controls {
    grid-template-columns: 1fr;
  }

  .mlb-command-grid {
    grid-template-columns: 1fr;
  }

  .espn-controls {
    grid-template-columns: 1fr;
  }

  .table-header input {
    max-width: none;
  }
}

/* Organized daily workflow UI */
.organized-ui .panel.controls {
  gap: 1rem;
}

.ui-quick-guide {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.04);
  display: grid;
  gap: 0.75rem;
}

.ui-quick-guide h2 {
  margin: 0;
  font-size: 1.15rem;
}

.ui-quick-guide ol {
  margin: 0;
  padding-left: 1.25rem;
  display: grid;
  gap: 0.35rem;
}

.ui-organized-sections {
  display: grid;
  gap: 1rem;
  margin-top: 1rem;
}

.ui-task-section {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 20px;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.035);
  display: grid;
  gap: 0.75rem;
}

.ui-task-section.primary {
  border-color: rgba(125, 211, 252, 0.35);
  background: rgba(125, 211, 252, 0.06);
}

.ui-task-section.predictions {
  border-color: rgba(134, 239, 172, 0.28);
}

.ui-task-section.data-tools {
  border-color: rgba(251, 191, 36, 0.26);
}

.ui-task-section.advanced {
  opacity: 0.88;
}

.ui-task-section-header {
  display: grid;
  gap: 0.2rem;
}

.ui-task-section-header h2 {
  margin: 0;
  font-size: 1rem;
}

.ui-task-section-header p {
  margin: 0;
  opacity: 0.72;
  line-height: 1.4;
}

.ui-task-section details {
  margin: 0;
}

.ui-task-section summary {
  cursor: pointer;
  font-weight: 700;
}

.ui-task-section .source-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.ui-task-section button {
  min-height: 2.75rem;
}

.ui-task-section pre.json-output {
  white-space: pre-wrap;
  line-height: 1.45;
  max-height: 32rem;
  overflow: auto;
}

.organized-ui .controls > details.data-manager,
.organized-ui .controls > details.model-refresh-panel {
  display: none;
}

/* UI cleanup: hide lower-priority sections and make left workflow panel scrollable */
.organized-ui .needs-panel,
.organized-ui .github-panel {
  display: none !important;
}

/* Keep the left workflow/control column usable on long pages */
.organized-ui .workspace {
  align-items: start;
}

.organized-ui .panel.controls {
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  overscroll-behavior: contain;
  padding-right: 0.75rem;
  scrollbar-width: thin;
}

/* Make the right side scroll naturally while the left side stays independently usable */
.organized-ui .results {
  min-width: 0;
}

/* Slightly cleaner spacing for the organized left-side workflow */
.organized-ui .ui-quick-guide,
.organized-ui .ui-organized-sections {
  width: 100%;
}

/* Optional: make large output boxes easier to read without stretching the whole left column */
.organized-ui .ui-task-section pre.json-output {
  max-height: 24rem;
  overflow: auto;
}

/* All Data guided predictor cleanup */
.all-data-clean-panel .model-refresh-body {
  display: block;
}

.all-data-guided-flow {
  display: grid;
  gap: 0.9rem;
}

.all-data-step {
  border: 1px solid rgba(255, 255, 255, 0.12);
