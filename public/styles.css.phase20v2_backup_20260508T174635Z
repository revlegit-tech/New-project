  padding: 22px;
  background:
    radial-gradient(circle at 15% 0%, rgba(56, 189, 248, 0.14), transparent 32rem),
    radial-gradient(circle at 90% 10%, rgba(168, 85, 247, 0.13), transparent 28rem),
    linear-gradient(180deg, rgba(8, 13, 25, 0.98), rgba(15, 23, 42, 0.96));
  box-shadow: 0 26px 70px rgba(0, 0, 0, 0.34);
  color: #e5edf9;
}

.data-confidence-shell h3,
.data-confidence-shell h4,
.workflow-state-shell h3,
.workflow-phase-card h4 {
  color: #f8fafc;
  letter-spacing: -0.035em;
}

.data-confidence-hero,
.workflow-state-header,
.workflow-phase-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
}

.data-confidence-hero p,
.workflow-state-header p {
  max-width: 760px;
  margin: 6px 0 0;
  color: #9fb0c8;
  line-height: 1.45;
}

.data-confidence-eyebrow {
  color: #93c5fd;
  font-size: 0.74rem;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.data-confidence-score {
  min-width: 178px;
  padding: 16px 18px;
  border-radius: 22px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(15, 23, 42, 0.76);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.data-confidence-score span,
.data-confidence-score small,
.data-confidence-kpis span,
.workflow-phase-meta {
  display: block;
  color: #94a3b8;
  font-size: 0.76rem;
  font-weight: 800;
}

.data-confidence-score strong {
  display: block;
  margin: 4px 0;
  color: #f8fafc;
  font-size: 1.35rem;
  font-weight: 950;
}

.data-confidence-kpis {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 18px;
}

.data-confidence-kpis div {
  padding: 13px 14px;
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.58);
}

.data-confidence-kpis strong {
  display: block;
  margin-top: 4px;
  color: #f8fafc;
  font-size: 0.9rem;
  font-weight: 950;
  overflow-wrap: anywhere;
}

.data-confidence-grid,
.workflow-phase-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.data-confidence-card,
.workflow-phase-card {
  min-height: 210px;
  padding: 17px;
  border-radius: 22px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background:
    radial-gradient(circle at top right, rgba(59, 130, 246, 0.08), transparent 12rem),
    rgba(15, 23, 42, 0.72);
  box-shadow: 0 16px 36px rgba(2, 6, 23, 0.22);
}

.workflow-phase-card {
  min-height: 160px;
}

.data-confidence-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.data-confidence-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: #22c55e;
  box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.14);
}

.data-confidence-card.partial .data-confidence-dot,
.workflow-phase-card.partial .data-confidence-dot,
.data-confidence-score.partial .data-confidence-dot {
  background: #f59e0b;
}

.data-confidence-card.missing .data-confidence-dot,
.workflow-phase-card.missing .data-confidence-dot {
  background: #64748b;
  box-shadow: 0 0 0 5px rgba(100, 116, 139, 0.18);
}

.data-confidence-card.failed .data-confidence-dot,
.workflow-phase-card.failed .data-confidence-dot {
  background: #ef4444;
  box-shadow: 0 0 0 5px rgba(239, 68, 68, 0.16);
}

.data-confidence-status,
.workflow-phase-status {
  color: #bfdbfe;
  font-size: 0.72rem;
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.data-confidence-card h4,
.workflow-phase-card h4 {
  margin: 0;
  font-size: 1rem;
}

.data-confidence-metric {
  margin-top: 12px;
  color: #f8fafc;
  font-size: 1.7rem;
  font-weight: 950;
  letter-spacing: -0.05em;
}

.data-confidence-card p,
.data-confidence-card small {
  display: block;
  color: #b8c4d8;
  line-height: 1.42;
}

.data-confidence-card p {
  margin: 6px 0 6px;
  font-weight: 800;
}

.data-confidence-timestamp,
.workflow-phase-meta {
  margin-top: 10px;
  color: #94a3b8;
  font-size: 0.74rem;
}

.data-confidence-warnings {
  margin: 12px 0 0;
  padding-left: 18px;
  color: #fed7aa;
  font-size: 0.76rem;
  line-height: 1.35;
}

.data-confidence-advanced-link {
  margin-top: 12px;
  border: 1px solid rgba(147, 197, 253, 0.32);
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.14);
  color: #bfdbfe;
  padding: 8px 11px;
  font-size: 0.72rem;
  font-weight: 900;
}

.workflow-state-shell {
  margin-top: 22px;
  padding-top: 20px;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
}

.workflow-phase-header strong {
  color: #f8fafc;
  font-size: 1.2rem;
}

.workflow-phase-checks {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.workflow-check {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 999px;
  padding: 6px 9px;
  color: #cbd5e1;
  background: rgba(2, 6, 23, 0.28);
  font-size: 0.74rem;
  font-weight: 850;
}

.workflow-check.ok {
  color: #bbf7d0;
  border-color: rgba(34, 197, 94, 0.25);
  background: rgba(34, 197, 94, 0.1);
}

.data-confidence-warning-panel {
  margin-top: 18px;
  border-radius: 18px;
  border: 1px solid rgba(251, 191, 36, 0.25);
  background: rgba(120, 53, 15, 0.22);
  padding: 14px 16px;
}

.data-confidence-warning-panel summary {
  color: #fde68a;
  font-weight: 950;
  cursor: pointer;
}

.data-confidence-warning-panel li {
  color: #ffedd5;
  margin-top: 6px;
}

@media (max-width: 1180px) {
  .data-confidence-grid,
  .workflow-phase-grid,
  .data-confidence-kpis {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .data-confidence-shell {
    padding: 16px;
    border-radius: 22px;
  }

  .data-confidence-hero,
  .workflow-state-header,
  .workflow-phase-header {
    display: grid;
  }

  .data-confidence-score {
    min-width: 0;
  }

  .data-confidence-grid,
  .workflow-phase-grid,
  .data-confidence-kpis {
    grid-template-columns: 1fr;
  }
}

/* Post-Phase 10 Outlier advanced prop detail hit-rate graph */
.prop-detail-trend-grid {
  display: grid;
  gap: 10px;
  margin: 14px 0 16px;
}

.prop-detail-trend-row {
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr) 54px 48px;
  align-items: center;
  gap: 10px;
  color: #cbd5e1;
  font-size: 0.82rem;
  font-weight: 800;
}

.prop-detail-trend-row span,
.prop-detail-trend-row em {
  color: #94a3b8;
  font-style: normal;
}

.prop-detail-trend-row strong {
  color: #e5edf7;
  text-align: right;
}

.prop-detail-trend-track {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.9);
  box-shadow: inset 0 0 0 1px rgba(148, 163, 184, 0.18);
}

.prop-detail-trend-track i {
  display: block;
  height: 100%;
  min-width: 2px;
  border-radius: inherit;
  background: linear-gradient(90deg, #14b8a6, #22c55e);
}

.prop-detail-game-chart {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(24px, 1fr));
  align-items: end;
  gap: 7px;
  min-height: 170px;
  padding: 18px 12px 10px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 18px;
  background:
    linear-gradient(to top, rgba(148, 163, 184, 0.08) 1px, transparent 1px) 0 0 / 100% 25%,
    rgba(2, 6, 23, 0.35);
}

.prop-detail-game-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
  height: 135px;
  min-width: 0;
}

.prop-detail-game-bar i {
  width: 100%;
  max-width: 32px;
  min-height: 6px;
  border-radius: 10px 10px 4px 4px;
  background: rgba(148, 163, 184, 0.28);
}

.prop-detail-game-bar.is-hit i {
  background: linear-gradient(180deg, #22c55e, #14b8a6);
  box-shadow: 0 0 18px rgba(20, 184, 166, 0.24);
}

.prop-detail-game-bar.is-miss i {
  background: rgba(148, 163, 184, 0.22);
}

.prop-detail-game-bar span {
  color: #cbd5e1;
  font-size: 0.72rem;
  font-weight: 900;
}
