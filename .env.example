# Optional: needed for private repositories or higher GitHub API rate limits.
# Create a fine-grained GitHub token with read access to repository metadata and Actions.
GITHUB_TOKEN=

# Optional default repo for the GitHub API panel.
# Example: your-username/baseball-prop-predictor
GITHUB_REPOSITORY=

# Optional: override the active MLB season used for year-suffixed data files.
MLB_CURRENT_SEASON=

# Sprint 13 optional warehouse database. Defaults keep local CSV mode working.
DB_ENABLED=0
DB_FALLBACK_TO_CSV=1
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_ECHO=0

# Sprint 18.5 legacy team/game market model projections.
# Default OFF: local models/team_game_markets/*.joblib artifacts must not affect live boards.
TEAM_GAME_MARKET_PROJECTIONS_ENABLED=0

# Sprint 4 cache/concurrency controls for the canonical ASGI runtime.
MLB_BOARD_CACHE_TTL_SECONDS=30
MLB_BOARD_CACHE_MAX_KEYS=256
MLB_MODEL_SNAPSHOT_CACHE_TTL_SECONDS=60
MLB_BLOCKING_WORK_MAX_CONCURRENT=24
MLB_BLOCKING_WORK_TIMEOUT_SECONDS=5
MLB_EDGE_BOARD_TIMEOUT_SECONDS=5
MLB_PLAYERBOARD_TIMEOUT_SECONDS=5
MLB_PROP_DETAIL_TIMEOUT_SECONDS=2

# Sprint 10 production security posture.
# Production: enforce CSP. Set to 1 only during UI migration or emergency debugging.
MLB_CSP_REPORT_ONLY=0
MLB_CSP_ALLOW_INLINE=0
MLB_READ_RATE_LIMIT_PER_MINUTE=120
MLB_READ_RATE_LIMIT_BURST=30
MLB_ADMIN_RATE_LIMIT_PER_MINUTE=10
MLB_RATE_LIMIT_MAX_BUCKETS=8192
MLB_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
