@@ -0,0 +1,153 @@
+import { MARKETS, button, createElement, jsonFetch, normalizeRows, propLabel, replaceChildren, rowKey, signedPercent, text, percent, formatOdds, renderStatePanel, dispatch, listen } from "/outlier-shared.js";
+
+const boardState = {
+  mounted: false,
+  rows: [],
+  filteredRows: [],
+  loading: false,
+  error: "",
+  market: "",
+  sort: "edge",
+  filters: {},
+};
+
+export async function mount() {
+  if (boardState.mounted) return;
+  boardState.mounted = true;
+  listen("outlier:view", (event) => {
+    if (event.detail.module === "board") renderBoardView(event.detail.state || {});
+  });
+  listen("outlier:filters", (event) => {
+    boardState.filters = event.detail || {};
+    applyFilters();
+    renderTable();
+  });
+}
+
+async function renderBoardView(shellState = {}) {
+  const host = document.getElementById("outlierWorkspace");
+  if (!host) return;
+  replaceChildren(host, [layout()]);
+  await loadBoard(shellState);
+}
+
+function layout() {
+  const wrapper = createElement("section", { className: "ob-board-module" });
+  const filters = createElement("div", { className: "ob-filter-row" }, MARKETS.map(([value, label]) => {
+    return button(label, { className: `ob-chip${value === boardState.market ? " is-active" : ""}`, dataset: { market: value } });
+  }));
+  filters.addEventListener("click", (event) => {
+    const target = event.target.closest("[data-market]");
+    if (!target) return;
+    boardState.market = target.dataset.market;
+    filters.querySelectorAll(".ob-chip").forEach((chip) => chip.classList.toggle("is-active", chip === target));
+    applyFilters();
+    renderTable();
+  });
+  wrapper.append(
+    createElement("div", { className: "ob-section-heading" }, [
+      createElement("div", {}, [
+        createElement("p", { className: "ob-kicker", text: "Primary board" }),
+        createElement("h2", { text: "High-density edge board" }),
+      ]),
+      createElement("span", { id: "outlierBoardMeta", className: "ob-board-meta", text: "Loading" }),
+    ]),
+    filters,
+    createElement("div", { id: "outlierBoardTable", className: "ob-board-table" })
+  );
+  return wrapper;
+}
+
+async function loadBoard(shellState = {}) {
+  const meta = document.getElementById("outlierBoardMeta");
+  const table = document.getElementById("outlierBoardTable");
+  boardState.loading = true;
+  boardState.error = "";
+  if (meta) meta.textContent = "Loading board";
+  replaceChildren(table, [renderStatePanel("Loading board", "Fetching cached EdgeBoard payload.", "partial")]);
+  try {
+    const params = new URLSearchParams();
+    if (shellState.date) params.set("date", shellState.date);
+    if (boardState.market) params.set("market", boardState.market);
+    const { payload, requestId } = await jsonFetch(`/api/edge-board${params.toString() ? `?${params}` : ""}`);
+    boardState.rows = normalizeRows(payload);
+    boardState.requestId = requestId || payload?.meta?.requestId || "";
+    boardState.cache = payload?.boardCache || { hit: Boolean(payload?.cacheHit) };
+    applyFilters();
+    renderTable();
+  } catch (error) {
+    boardState.error = text(error?.message, "Failed to load EdgeBoard.");
+    replaceChildren(table, [renderStatePanel("Missing Data", boardState.error, "bad")]);
+    if (meta) meta.textContent = "Missing Data";
+  } finally {
+    boardState.loading = false;
+  }
+}
+
+function applyFilters() {
+  const search = String(boardState.filters.search || "").toLowerCase().trim();
+  boardState.filteredRows = boardState.rows.filter((row) => {
+    const marketMatch = !boardState.market || row.market === boardState.market || row.marketDisplay === boardState.market;
+    const haystack = [row.player, row.playerName, row.team, row.opponent, row.market, row.marketDisplay].join(" ").toLowerCase();
+    const searchMatch = !search || haystack.includes(search);
+    return marketMatch && searchMatch;
+  }).sort((a, b) => Number(b.finalEdgePercent || b.edge || 0) - Number(a.finalEdgePercent || a.edge || 0));
+}
+
+function renderTable() {
+  const table = document.getElementById("outlierBoardTable");
+  const meta = document.getElementById("outlierBoardMeta");
+  if (!table) return;
+  if (!boardState.filteredRows.length) {
+    replaceChildren(table, [renderStatePanel("No board rows", "No market rows matched the active filters. This is Missing Data, not a fallback board.", "bad")]);
+    if (meta) meta.textContent = "0 rows";
+    return;
+  }
+  const rows = boardState.filteredRows.slice(0, 80);
+  const grid = createElement("div", { className: "ob-table-grid", attrs: { role: "table", "aria-label": "Outlier edge board" } });
+  grid.append(headerRow());
+  rows.forEach((row, index) => grid.append(dataRow(row, index)));
+  replaceChildren(table, [grid]);
+  if (meta) {
+    const cache = boardState.cache?.hit ? "cache hit" : "cache miss";
+    meta.textContent = `${boardState.filteredRows.length} rows · ${cache}${boardState.requestId ? ` · ${boardState.requestId}` : ""}`;
+  }
+}
+
+function headerRow() {
+  return createElement("div", { className: "ob-table-row ob-table-head", attrs: { role: "row" } }, [
+    cell("Player", "head"), cell("Prop", "head"), cell("Model", "head"), cell("Implied", "head"), cell("Edge", "head"), cell("Odds", "head"), cell("Readiness", "head"),
+  ]);
+}
+
+function dataRow(row, index) {
+  const model = row.finalProbabilityPercent || row.modelProbability || row.probability;
+  const implied = row.sportsbookImpliedPercent || row.impliedProbability;
+  const edge = row.finalEdgePercent || row.edge;
+  const readiness = row.modelCard?.status || row.readiness || row.confidence || (row.missingData?.length ? "Research Only" : "Ready Check");
+  const element = createElement("button", {
+    className: `ob-table-row ob-data-row ${Number(edge) > 0 ? "is-positive" : "is-neutral"}`,
+    type: "button",
+    dataset: { key: rowKey(row), index },
+    attrs: { role: "row" },
+  }, [
+    cell(text(row.player || row.playerName || row.team, "Unknown"), "strong"),
+    cell(propLabel(row)),
+    cell(percent(model)),
+    cell(percent(implied)),
+    cell(signedPercent(edge)),
+    cell(formatOdds(row.americanOdds || row.odds)),
+    cell(readiness),
+  ]);
+  element.addEventListener("click", () => {
+    dispatch("outlier:prop-selected", { row, index, source: "edge-board" });
+    import("/outlier-detail.js").then((module) => module.mount?.()).then(() => dispatch("outlier:open-detail", { row, index }));
+  });
+  return element;
+}
+
+function cell(value, kind = "cell") {
+  return createElement("span", { className: `ob-table-cell ob-${kind}`, text: value, attrs: { role: kind === "head" ? "columnheader" : "cell" } });
+}
+
+export const __testHooks = { boardState, applyFilters };
