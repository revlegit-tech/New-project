@@ -0,0 +1,199 @@
+import { MODULES, createElement, replaceChildren, jsonFetch, text, todayIso } from "/outlier-shared.js";
+
+const moduleLoaders = {
+  board: () => import("/outlier-board.js"),
+  detail: () => import("/outlier-detail.js"),
+  picks: () => import("/outlier-picks.js"),
+  "model-room": () => import("/outlier-model-room.js"),
+  admin: () => import("/outlier-admin.js"),
+};
+
+const loaded = new Map();
+const state = {
+  activeView: "today",
+  date: todayIso(),
+  market: "",
+  search: "",
+  status: null,
+  requestId: "",
+};
+
+export async function bootOutlierApp({ params } = {}) {
+  if (params?.get("view") && params.get("view") !== "outlier") return;
+  createShell();
+  bindShellEvents();
+  await loadStatus();
+  await activateView("today");
+}
+
+function createShell() {
+  const main = document.querySelector("main") || document.body;
+  const shell = createElement("main", { id: "outlierApp", className: "ob-shell ob-shell-modular" });
+  const nav = createElement("nav", { className: "ob-sidebar", attrs: { "aria-label": "Outlier navigation" } });
+  nav.append(
+    createElement("div", { className: "ob-brand" }, [
+      createElement("span", { className: "ob-brand-mark", text: "O" }),
+      createElement("div", {}, [
+        createElement("strong", { text: "Outlier" }),
+        createElement("small", { text: "MLB research desk" }),
+      ]),
+    ]),
+    createElement("div", { className: "ob-nav-list" }, Object.entries(MODULES).map(([key, item]) => {
+      const button = createElement("button", {
+        className: `ob-nav-item${key === state.activeView ? " is-active" : ""}${item.devOnly ? " is-dev-only" : ""}`,
+        type: "button",
+        text: item.label,
+        dataset: { view: key, module: item.module },
+      });
+      return button;
+    }))
+  );
+
+  const header = createElement("header", { className: "ob-topbar" }, [
+    createElement("div", {}, [
+      createElement("p", { className: "ob-kicker", text: "Controlled promotion runtime" }),
+      createElement("h1", { text: "Today’s MLB Edge Board" }),
+    ]),
+    createElement("div", { className: "ob-topbar-actions" }, [
+      createElement("input", {
+        className: "ob-input",
+        type: "date",
+        value: state.date,
+        dataset: { control: "date" },
+        attrs: { "aria-label": "Board date" },
+      }),
+      createElement("input", {
+        className: "ob-input ob-input-search",
+        type: "search",
+        placeholder: "Search player, team, market",
+        dataset: { control: "search" },
+        attrs: { "aria-label": "Search board" },
+      }),
+    ]),
+  ]);
+
+  const trust = createElement("section", { id: "outlierTrustSurface", className: "ob-trust-panel" });
+  const workspace = createElement("section", { id: "outlierWorkspace", className: "ob-workspace", attrs: { "aria-live": "polite" } });
+  const rail = createElement("aside", { id: "outlierDetailHost", className: "ob-detail-host" });
+  const content = createElement("section", { className: "ob-main" }, [header, trust, workspace]);
+  shell.append(nav, content, rail);
+  main.replaceWith(shell);
+}
+
+function bindShellEvents() {
+  document.addEventListener("click", async (event) => {
+    const nav = event.target.closest("[data-view]");
+    if (nav) {
+      await activateView(nav.dataset.view);
+    }
+  });
+
+  document.addEventListener("input", async (event) => {
+    const control = event.target.dataset?.control;
+    if (control === "search") {
+      state.search = event.target.value;
+      document.dispatchEvent(new CustomEvent("outlier:filters", { detail: { ...state } }));
+    }
+  });
+
+  document.addEventListener("change", async (event) => {
+    const control = event.target.dataset?.control;
+    if (control === "date") {
+      state.date = event.target.value || todayIso();
+      document.dispatchEvent(new CustomEvent("outlier:filters", { detail: { ...state } }));
+    }
+  });
+}
+
+async function activateView(key) {
+  const item = MODULES[key] || MODULES.today;
+  state.activeView = key in MODULES ? key : "today";
+  document.querySelectorAll(".ob-nav-item").forEach((node) => {
+    node.classList.toggle("is-active", node.dataset.view === state.activeView);
+  });
+  await ensureModule(item.module);
+  document.dispatchEvent(new CustomEvent("outlier:view", { detail: { view: state.activeView, module: item.module, state: { ...state } } }));
+}
+
+async function ensureModule(name) {
+  if (loaded.has(name)) return loaded.get(name);
+  const loader = moduleLoaders[name];
+  if (!loader) throw new Error(`Unknown Outlier module: ${name}`);
+  const module = await loader();
+  if (typeof module.mount === "function") {
+    await module.mount({ state });
+  }
+  loaded.set(name, module);
+  return module;
+}
+
+async function loadStatus() {
+  const host = document.getElementById("outlierTrustSurface");
+  if (!host) return;
+  host.replaceChildren(renderTrustSkeleton());
+  try {
+    const { payload, requestId } = await jsonFetch("/api/app/status");
+    state.status = payload;
+    state.requestId = requestId || payload?.meta?.requestId || "";
+    host.replaceChildren(renderTrust(payload, state.requestId));
+  } catch (error) {
+    host.replaceChildren(renderTrustFailure(error));
+  }
+}
+
+function renderTrustSkeleton() {
+  return createElement("div", { className: "ob-trust-grid" }, [
+    createElement("div", {}, [
+      createElement("p", { className: "ob-kicker", text: "Research Only" }),
+      createElement("h2", { text: "Checking model readiness" }),
+      createElement("p", { text: "The board stays research-only until app status confirms data health and readiness." }),
+    ]),
+  ]);
+}
+
+function renderTrust(payload, requestId) {
+  const label = text(payload?.productStateDetail?.label || payload?.productState, "Research Only");
+  const confidence = text(payload?.dataConfidence || payload?.playerboard?.dataConfidence, "Missing");
+  const markets = Array.isArray(payload?.productionEligibleMarkets) ? payload.productionEligibleMarkets.length : 0;
+  const panel = createElement("div", { className: `ob-trust-grid ${confidence.toLowerCase() === "good" ? "is-good" : "is-partial"}` });
+  panel.append(
+    createElement("div", {}, [
+      createElement("p", { className: "ob-kicker", text: label }),
+      createElement("h2", { text: "Trust surface is live" }),
+      createElement("p", { text: text(payload?.productStateDetail?.message, "Treat picks as research-only unless market readiness is explicit.") }),
+    ]),
+    metricGroup([
+      ["Board date", payload?.latestBoardDate || payload?.playerboard?.latestAvailableDate],
+      ["Data confidence", confidence],
+      ["Grading", payload?.grading?.state],
+      ["Production markets", markets],
+      ["Request ID", requestId || payload?.meta?.requestId],
+    ])
+  );
+  return panel;
+}
+
+function renderTrustFailure(error) {
+  return createElement("div", { className: "ob-trust-grid is-bad" }, [
+    createElement("div", {}, [
+      createElement("p", { className: "ob-kicker", text: "Research Only" }),
+      createElement("h2", { text: "Status unavailable" }),
+      createElement("p", { text: text(error?.message, "Missing app-status contract. Treat all markets as research-only.") }),
+    ]),
+  ]);
+}
+
+function metricGroup(rows) {
+  const list = createElement("dl", { className: "ob-trust-metrics" });
+  rows.forEach(([label, value]) => {
+    list.append(
+      createElement("div", {}, [
+        createElement("dt", { text: label }),
+        createElement("dd", { text: text(value) }),
+      ])
+    );
+  });
+  return list;
+}
+
+export const __testHooks = { moduleLoaders, loaded, state, activateView };
diff -ruN /mnt/data/phase7_cumulative_app_status_contract_artifacts/public/outlier-detail.js /mnt/data/phase8_cumulative_frontend_architecture_artifacts/public/outlier-detail.js
