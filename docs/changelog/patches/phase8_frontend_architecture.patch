@@ -0,0 +1,88 @@
+import { createElement, dispatch, jsonFetch, propLabel, replaceChildren, text, percent, signedPercent, formatOdds, renderStatePanel, listen } from "/outlier-shared.js";
+
+let mounted = false;
+let selectedRow = null;
+
+export async function mount() {
+  if (mounted) return;
+  mounted = true;
+  listen("outlier:open-detail", (event) => openDetail(event.detail.row));
+  listen("outlier:prop-selected", (event) => { selectedRow = event.detail.row; });
+}
+
+async function openDetail(row) {
+  selectedRow = row;
+  const host = document.getElementById("outlierDetailHost");
+  if (!host) return;
+  host.classList.add("is-open");
+  replaceChildren(host, [detailShell(row, renderStatePanel("Loading prop detail", "Reusing cached EdgeBoard row before requesting extra context.", "partial"))]);
+  try {
+    const params = new URLSearchParams();
+    const player = row.player || row.playerName;
+    if (player) params.set("player", player);
+    if (row.market) params.set("market", row.market);
+    if (row.line) params.set("line", row.line);
+    if (row.rawLabel || row.side) params.set("side", row.rawLabel || row.side);
+    const { payload, requestId } = await jsonFetch(`/api/prop-detail?${params}`);
+    replaceChildren(host, [detailShell(row, renderDetail(payload, requestId))]);
+  } catch (error) {
+    replaceChildren(host, [detailShell(row, renderStatePanel("Detail unavailable", text(error?.message, "Missing prop detail data."), "bad"))]);
+  }
+}
+
+function detailShell(row, body) {
+  const close = createElement("button", { className: "ob-detail-close", type: "button", text: "×", attrs: { "aria-label": "Close detail" } });
+  close.addEventListener("click", () => {
