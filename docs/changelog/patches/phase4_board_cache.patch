+            self._phase("weekly", "Weekly", [
+                ("Retraining summary", bool(production_markets) or bool(trained_markets)),
+                ("Calibration/model cards", bool(model_status.get("markets"))),
+                ("Weekly repair summary", bool(weekly_repair.get("exists"))),
+            ], weekly_repair),
