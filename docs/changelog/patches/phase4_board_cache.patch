+            self._phase("postgame", "Postgame", [
+                ("Finals", (health.get("finalGames") or 0) > 0),
+                ("Boxscores", (health.get("boxscoresSaved") or 0) > 0),
+                ("Grading", grading.get("state") == "graded"),
